generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Organization {
  id                      String                   @id @default(cuid())
  name                    String
  displayName             String
  cnpj                    String?
  segment                 String                   @default("geral")
  timezone                String                   @default("America/Sao_Paulo")
  currency                String                   @default("BRL")
  status                  String                   @default("active")
  logoUrl                 String? // legado (URL digitada); o logotipo enviado fica em UPLOADS_DIR (logoType/logoUpdatedAt)
  logoType                String? // image/webp | image/png | image/jpeg: logotipo enviado em Configurações › Empresa
  logoUpdatedAt           DateTime?
  website                 String?
  phone                   String?
  adminEmail              String?
  settingsJson            String?
  // Encerramento da conta pelo próprio cliente (LGPD): apagada de vez em deletionScheduledFor, salvo se desistir antes
  deletionRequestedAt     DateTime?
  deletionScheduledFor    DateTime?
  deletionRequestedBy     String? // id do membro (dono) que pediu
  // Ambiente de simulação (S1): empresa criada pelo operador para testar cenários. Fica fora de motor agendado,
  // e-mails, webhooks, cobrança, relatórios agendados, analytics e métricas do Admin (src/lib/sandbox.ts).
  isSimulation            Boolean                  @default(false)
  simulationExpiresAt     DateTime? // apagada sozinha depois disto (24 h)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  connections             WhatsAppConnection[]
  agents                  Agent[]
  conversations           Conversation[]
  alerts                  Alert[]
  recoveryItems           RecoveryItem[]
  reports                 ReportRun[]
  alertRules              AlertRule[]
  dailyMetrics            DailyMetric[]
  agentMetrics            AgentMetric[]
  reportDefinitions       ReportDefinition[]
  members                 OrganizationMember[]
  teams                   Team[]
  subscription            Subscription?
  notifications           Notification[]
  classificationFeedbacks ClassificationFeedback[]
  auditLogs               AuditLog[]
  billingInvoices         BillingInvoice[]
  supportTickets          SupportTicket[]

  @@index([isSimulation, simulationExpiresAt])
}

model WhatsAppConnection {
  id              String                   @id @default(cuid())
  organizationId  String
  organization    Organization             @relation(fields: [organizationId], references: [id])
  name            String
  provider        String                   @default("baileys")
  phoneNumber     String
  phoneLast4      String
  status          String                   @default("pending")
  statusReason    String?
  lastSeenAt      DateTime?
  lastEventAt     DateTime?
  lastSyncAt      DateTime?
  pairedAt        DateTime?
  disabledAt      DateTime?
  qrCode          String? // último QR emitido pelo WhatsApp (some quando conecta)
  qrUpdatedAt     DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  conversations   Conversation[]
  sessionEvents   ConnectionSessionEvent[]
  rawEvents       RawChannelEvent[]
  agentIdentities AgentIdentity[]
}

model Agent {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  name           String
  email          String
  role           String          @default("atendente")
  team           String?
  externalRef    String?
  status         String          @default("active")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  conversations  Conversation[]
  recoveryItems  RecoveryItem[]
  identities     AgentIdentity[]
  metrics        AgentMetric[]
}

model Contact {
  id             String         @id @default(cuid())
  organizationId String
  connectionId   String?
  displayName    String?
  phoneHash      String?
  phoneEncrypted String? // B5/B9 · telefone completo cifrado (AES-256-GCM, PHONE_ENC_KEY); null sem a chave
  phoneLast4     String?
  isGroup        Boolean        @default(false)
  excluded       Boolean        @default(false)
  firstSeenAt    DateTime       @default(now())
  lastSeenAt     DateTime       @default(now())
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  conversations  Conversation[]

  @@index([organizationId, phoneHash]) // ingestão: reconhecer o contato pelo telefone
}

model Conversation {
  id                String                       @id @default(cuid())
  organizationId    String
  organization      Organization                 @relation(fields: [organizationId], references: [id])
  connectionId      String?
  connection        WhatsAppConnection?          @relation(fields: [connectionId], references: [id])
  contactId         String?
  contact           Contact?                     @relation(fields: [contactId], references: [id])
  agentId           String?
  agent             Agent?                       @relation(fields: [agentId], references: [id])
  agentAttribution  String? // P5 · de onde veio o agentId: identity (vínculo confirmado) | manual; null = legado/sem atendente
  suggestedAgentId  String? // P5 · atendente só sugerido (identidade não confirmada): aparece como "sugerido", não conta nos indicadores
  identitySightings ConversationIdentity[]
  operationalStatus String                       @default("new")
  inferredStage     String                       @default("discovery")
  primaryIntent     String?
  urgency           String                       @default("normal")
  sentiment         String                       @default("neutral")
  score             Float                        @default(0)
  riskScore         Float                        @default(0)
  potentialValue    Float                        @default(0)
  confidence        Float                        @default(0)
  lastInboundAt     DateTime?
  lastOutboundAt    DateTime?
  waitingSince      DateTime?
  needsAnalysisAt   DateTime? // I8 · marcada pela ingestão/ações manuais; o motor limpa ao analisar (motor incremental)
  openedAt          DateTime                     @default(now())
  closedAt          DateTime?
  reviewedAt        DateTime?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  messages          Message[]
  classifications   ConversationClassification[]
  findings          AuditFinding[]
  opportunities     RevenueOpportunity[]
  alerts            Alert[]
  tags              String                       @default("[]")
  openQuestions     OpenQuestion[]
  promises          Promise[]
  scores            ConversationScore[]

  // T15 · desempenho: lista de conversas, painel, motor, ingestão e relatórios
  @@index([organizationId, updatedAt])
  @@index([organizationId, riskScore])
  @@index([organizationId, openedAt])
  @@index([organizationId, operationalStatus])
  @@index([contactId])
  @@index([agentId])
  @@index([connectionId, contactId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      String
  senderType     String       @default("customer")
  messageType    String       @default("text")
  text           String?
  occurredAt     DateTime     @default(now())
  isAutomatic    Boolean      @default(false)
  deliveryStatus String       @default("delivered")
  createdAt      DateTime     @default(now())
  connectionId   String? // de qual número entrou (mensagens reais do WhatsApp)
  externalId     String? // id da mensagem no WhatsApp: garante que a mesma mensagem não entra duas vezes

  @@unique([connectionId, externalId])
  @@index([conversationId, occurredAt])
  @@index([occurredAt]) // retenção: mensagens antigas
}

model ConversationClassification {
  id                 String       @id @default(cuid())
  conversationId     String
  conversation       Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  classificationType String
  label              String
  confidence         Float        @default(0)
  evidenceMessageId  String?
  rationale          String?
  source             String       @default("ai")
  reviewedStatus     String       @default("pending")
  createdAt          DateTime     @default(now())

  @@index([conversationId])
}

model AuditFinding {
  id               String       @id @default(cuid())
  conversationId   String
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  type             String
  severity         String       @default("medium")
  status           String       @default("new")
  detectedAt       DateTime     @default(now())
  dueAt            DateTime?
  resolvedAt       DateTime?
  evidence         String?
  confidence       Float        @default(0)
  assignedTo       String?
  resolutionReason String?
  falsePositive    Boolean      @default(false)
  createdAt        DateTime     @default(now())

  @@index([conversationId])
}

model RevenueOpportunity {
  id                 String         @id @default(cuid())
  conversationId     String
  conversation       Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  status             String         @default("active")
  intentFactor       Float          @default(0.5)
  urgencyFactor      Float          @default(0.5)
  lossFactor         Float          @default(0.5)
  baseTicket         Float          @default(0)
  ticketSource       String         @default("global_average")
  probability        Float          @default(0.18)
  probabilitySource  String         @default("default_conservative")
  expectedValue      Float          @default(0)
  rangeLow           Float          @default(0)
  rangeHigh          Float          @default(0)
  confidence         Float          @default(0)
  confirmedSaleValue Float?
  confirmedRecovered Float?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  recoveryItems      RecoveryItem[]

  @@index([conversationId])
}

model Alert {
  id              String        @id @default(cuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id])
  conversationId  String?
  conversation    Conversation? @relation(fields: [conversationId], references: [id])
  findingId       String?
  ruleName        String?
  severity        String        @default("medium")
  title           String
  description     String?
  customerName    String?
  agentName       String?
  status          String        @default("new")
  potentialValue  Float?
  confidence      Float?
  assignedTo      String?
  dismissedReason String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([organizationId, createdAt])
  @@index([organizationId, status])
  @@index([conversationId])
}

model RecoveryItem {
  id                String              @id @default(cuid())
  organizationId    String
  organization      Organization        @relation(fields: [organizationId], references: [id])
  opportunityId     String?
  opportunity       RevenueOpportunity? @relation(fields: [opportunityId], references: [id])
  conversationId    String?
  agentId           String?
  agent             Agent?              @relation(fields: [agentId], references: [id])
  reason            String?
  priorityScore     Float               @default(0)
  assignedTo        String?
  dueAt             DateTime?
  status            String              @default("new")
  attempts          Int                 @default(0)
  outcome           String?
  recoveredValue    Float?
  completedAt       DateTime?
  customerName      String?
  originalAgentName String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([organizationId, priorityScore])
  @@index([conversationId])
}

model ReportRun {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  reportType      String
  status          String       @default("pending")
  periodStart     DateTime?
  periodEnd       DateTime?
  recipientEmails String       @default("[]")
  filePath        String?
  contentJson     String? // foto dos dados no momento da geração (o arquivo é montado a partir dela)
  source          String       @default("manual") // manual | schedule (agendado: "tentar novamente" também reenvia o e-mail)
  error           String? // motivo da falha (geração ou envio), mostrado no histórico
  emailStatus     String? // null = sem envio | queued | sent | failed
  emailedAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

// ============================================================
// NEW MODELS
// ============================================================

model ConnectionSessionEvent {
  id               String             @id @default(cuid())
  connectionId     String
  connection       WhatsAppConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  eventType        String
  previousStatus   String?
  newStatus        String?
  reasonCode       String?
  sanitizedDetails String?
  occurredAt       DateTime           @default(now())
}

model RawChannelEvent {
  id               String             @id @default(cuid())
  connectionId     String
  connection       WhatsAppConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  eventId          String             @unique
  idempotencyKey   String             @unique
  schemaVersion    String             @default("1.0")
  eventType        String
  payload          String             @default("{}")
  occurredAt       DateTime           @default(now())
  receivedAt       DateTime           @default(now())
  processingStatus String             @default("pending")
  errorCode        String?
  attempts         Int                @default(0)
}

// Quem fala pela empresa num número (P5 · §18.2). agentId = vínculo CONFIRMADO por admin/gestor (só ele conta nos
// indicadores); suggestedAgentId = palpite do sistema. associationStatus: unconfirmed | confirmed | ignored.
model AgentIdentity {
  id                String                 @id @default(cuid())
  agentId           String?
  agent             Agent?                 @relation(fields: [agentId], references: [id], onDelete: SetNull)
  displayName       String
  externalRef       String? // chave da identidade na conexão: sig:<nome normalizado> | dev:<tipo> | num
  connectionId      String
  connection        WhatsAppConnection     @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  team              String?
  associationStatus String                 @default("unconfirmed")
  confidence        Float                  @default(0)
  validFrom         DateTime               @default(now())
  validTo           DateTime?
  confirmedBy       String?
  kind              String                 @default("signature") // signature | device | number
  suggestedAgentId  String?
  suggestionReason  String?
  confirmedAt       DateTime?
  conversationCount Int                    @default(0)
  messageCount      Int                    @default(0)
  firstSeenAt       DateTime?
  lastSeenAt        DateTime?
  sightings         ConversationIdentity[]

  @@index([connectionId, externalRef])
}

// Em quais conversas cada identidade apareceu (base da atribuição; permite recalcular só as conversas afetadas).
model ConversationIdentity {
  id             String        @id @default(cuid())
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  identityId     String
  identity       AgentIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  messageCount   Int           @default(0)
  firstSeenAt    DateTime
  lastSeenAt     DateTime

  @@unique([conversationId, identityId])
  @@index([identityId])
}

model OpenQuestion {
  id                 String       @id @default(cuid())
  conversationId     String
  conversation       Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sourceMessage      String
  normalizedQuestion String?
  askedAt            DateTime     @default(now())
  dueAt              DateTime?
  answeredByMessage  String?
  status             String       @default("open")
  confidence         Float        @default(0)

  @@index([conversationId])
}

model Promise {
  id                String       @id @default(cuid())
  conversationId    String
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sourceMessage     String
  promisorAgent     String
  action            String
  dueAt             DateTime?
  duePrecision      String?
  status            String       @default("open")
  completionMessage String?
  confidence        Float        @default(0)

  @@index([conversationId])
}

model ConversationScore {
  id              String       @id @default(cuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  version         Int          @default(1)
  total           Float        @default(0)
  componentScores String       @default("{}")
  eligibility     Boolean      @default(true)
  calculatedAt    DateTime     @default(now())

  @@index([conversationId])
}

model AlertRule {
  id                   String       @id @default(cuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id])
  name                 String
  type                 String
  active               Boolean      @default(true)
  severity             String       @default("medium")
  scopeConnections     String       @default("[]")
  scopeTeams           String       @default("[]")
  daysAndHours         String       @default("{}")
  limitMinutes         Int?
  notificationChannels String       @default("[\"in_app\"]")
  recipients           String       @default("[]")
  cooldownMinutes      Int          @default(30)
  autoCloseMinutes     Int?
  exceptions           String       @default("[]")
  minConfidence        Float        @default(0.5)
}

model DailyMetric {
  id                    String       @id @default(cuid())
  organizationId        String
  organization          Organization @relation(fields: [organizationId], references: [id])
  date                  String
  connectionId          String?
  teamId                String?
  conversationsStarted  Int          @default(0)
  customersWaiting      Int          @default(0)
  medianFirstResponse   Float        @default(0)
  opportunitiesDetected Int          @default(0)
  opportunitiesAtRisk   Int          @default(0)
  overduePromises       Int          @default(0)
  potentialValueAtRisk  Float        @default(0)
  overallScore          Float        @default(0)
  messagesReceived      Int          @default(0)
  messagesSent          Int          @default(0)

  @@index([organizationId, date])
}

model AgentMetric {
  id                   String       @id @default(cuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id])
  agentId              String
  agent                Agent        @relation(fields: [agentId], references: [id])
  date                 String
  conversations        Int          @default(0)
  avgResponseTime      Float        @default(0)
  score                Float        @default(0)
  opportunitiesHandled Int          @default(0)
  opportunitiesLost    Int          @default(0)
  promisesKept         Int          @default(0)
  promisesTotal        Int          @default(0)
  questionsAnswered    Int          @default(0)
  questionsTotal       Int          @default(0)

  @@index([agentId, date])
}

model ReportDefinition {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  reportType     String
  name           String
  description    String?
  schedule       String?
  timezone       String       @default("America/Sao_Paulo")
  daysOfWeek     String       @default("[]")
  recipients     String       @default("[]")
  channels       String       @default("[\"email\"]")
  sendEmpty      Boolean      @default(false)
  lastRunAt      DateTime?
}

model ClassificationFeedback {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  targetId         String
  targetType       String
  previousValue    String?
  correctedValue   String?
  justification    String?
  userId           String?
  appliedToMetrics Boolean      @default(false)
  createdAt        DateTime     @default(now())
}

model Notification {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String?
  type           String
  title          String
  message        String?
  data           String       @default("{}")
  read           Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
}

model OrganizationMember {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  userId          String
  name            String
  email           String
  role            String       @default("member")
  team            String?
  status          String       @default("active")
  lastAccessAt    DateTime?
  mfaEnabled      Boolean      @default(false)
  seenToursJson   String?
  // Tour pelo sistema (manual interativo): progresso por capítulo, ex.: {"chapters":{"equipes":{"step":2,"done":false}},"last":"equipes"}
  systemTourJson  String?
  invitedAt       DateTime     @default(now())
  invitedBy       String?
  // --- autenticação real (B1) ---
  passwordHash    String? // scrypt; null = conta legada de demonstração ou convite ainda não aceito
  emailVerifiedAt DateTime?
  failedLogins    Int          @default(0)
  lockedUntil     DateTime?
  sessionVersion  Int          @default(0) // incrementa ao trocar senha: derruba as sessões antigas
  // --- aceite dos termos (B9/V4/T1): versão vigente no cadastro ou no aceite do convite (src/lib/legal.ts) ---
  termsVersion    String?
  privacyVersion  String?
  termsAcceptedAt DateTime?
  // Alertas por e-mail (regras com canal "email"): ligado por padrão; o link "parar de receber" do e-mail desliga
  alertEmails     Boolean      @default(true)
  // Foto do perfil (P7): arquivo em UPLOADS_DIR/<organização>/avatar-<membro>; null = mostra a inicial
  avatarType      String?
  avatarUpdatedAt DateTime?
  // Troca de e-mail (P7): o novo e-mail fica aqui até ser confirmado pelo link enviado a ele (token email_change)
  pendingEmail    String?
}

// Tokens de uso único enviados por e-mail (recuperar senha, aceitar convite, confirmar e-mail). Só o hash é guardado.
model AuthToken {
  id        String    @id @default(cuid())
  memberId  String
  type      String // reset | invite | verify | email_change
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// Registro de todo e-mail enviado pelo sistema. Sem provedor configurado ficam 'queued' (nada sai da máquina).
model EmailOutbox {
  id          String    @id @default(cuid())
  toEmail     String
  subject     String
  body        String
  status      String    @default("queued") // queued | sent | failed
  error       String?
  attachments String? // anexos enviados: JSON [{ filename, size }] (o conteúdo não fica guardado)
  createdAt   DateTime  @default(now())
  sentAt      DateTime?
  // Novas tentativas automáticas (src/lib/mailer.ts): só e-mails sem anexo; nextAttemptAt null = não tenta mais
  attempts       Int       @default(0) // envios tentados no provedor
  nextAttemptAt  DateTime?
  headers        String? // cabeçalhos extras em JSON (List-Unsubscribe), reenviados nas novas tentativas
  kind           String? // alert | alert_digest | null (conta, relatórios, suporte)
  organizationId String? // empresa dona do e-mail (alertas): aviso de falha e exclusão da conta

  @@index([status, nextAttemptAt])
}

// Alertas por e-mail (P4/T13): um item por alerta e destinatário. O envio respeita o intervalo mínimo por regra e
// pessoa (o que chega nesse intervalo vai junto num resumo) e o horário de silêncio. Sem texto de mensagem nem telefone.
model AlertEmailItem {
  id             String    @id @default(cuid())
  organizationId String
  memberId       String
  ruleId         String
  ruleName       String
  alertId        String
  severity       String
  status         String    @default("pending") // pending | sending | sent | skipped
  outboxId       String?
  createdAt      DateTime  @default(now())
  sentAt         DateTime?

  @@index([status, organizationId])
  @@index([memberId, ruleId, status, sentAt])
}

model Team {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  code           String
  unitId         String?
  supervisorId   String?
  connectionIds  String       @default("[]")
  slaConfig      String       @default("{}")
  goals          String       @default("{}")
  active         Boolean      @default(true)
}

model Plan {
  id                      String         @id @default(cuid())
  code                    String         @unique
  name                    String
  description             String?
  monthlyPrice            Float          @default(0)
  annualPrice             Float          @default(0)
  stripePriceIds          String         @default("{}")
  currency                String         @default("BRL")
  trialDays               Int            @default(0)
  maxConnections          Int            @default(1)
  maxAgents               Int            @default(1)
  maxConversationsMonthly Int            @default(100)
  maxMessagesMonthly      Int            @default(500)
  maxAudioMinutes         Int            @default(0)
  retentionDays           Int            @default(30)
  maxExports              Int            @default(5)
  maxAlertRules           Int            @default(5)
  features                String         @default("{}")
  active                  Boolean        @default(true)
  sortOrder               Int            @default(0)
  highlight               Boolean        @default(false)
  subscriptions           Subscription[]
}

model Subscription {
  id                            String       @id @default(cuid())
  organizationId                String       @unique
  organization                  Organization @relation(fields: [organizationId], references: [id])
  planId                        String
  plan                          Plan         @relation(fields: [planId], references: [id])
  stripeCustomerId              String?
  stripeSubscriptionId          String?
  status                        String       @default("active")
  currentPeriodStart            DateTime     @default(now())
  currentPeriodEnd              DateTime     @default(now())
  trialEnd                      DateTime?
  cancelAtPeriodEnd             Boolean      @default(false)
  createdAt                     DateTime     @default(now())
  // Cobrança recorrente (Pagar.me). stripe* acima são legado, sem uso.
  billingProvider               String? // "pagarme"
  billingMode                   String? // "test" | "live" (as chaves usadas quando a assinatura foi criada)
  providerCustomerId            String?
  providerSubscriptionId        String?
  pendingProviderSubscriptionId String? // troca de plano esperando a 1ª cobrança ser confirmada
  billingCycle                  String       @default("monthly") // monthly | annual
  paymentMethod                 String? // credit_card
  cardBrand                     String?
  cardLast4                     String?
  lastPaymentError              String?
  lastSyncedAt                  DateTime?

  @@index([providerSubscriptionId])
}

// Faturas da cobrança recorrente, espelhadas do Pagar.me (a fonte de verdade é o provedor; isto é cache para a tela).
model BillingInvoice {
  id                     String       @id @default(cuid())
  organizationId         String
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider               String       @default("pagarme")
  providerInvoiceId      String       @unique
  providerSubscriptionId String
  providerChargeId       String?
  planId                 String?
  planName               String?
  billingCycle           String?
  amountCents            Int
  status                 String // pending | paid | canceled | scheduled | failed
  paymentMethod          String?
  dueAt                  DateTime?
  paidAt                 DateTime?
  periodStart            DateTime?
  periodEnd              DateTime?
  failureMessage         String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  @@index([organizationId, createdAt])
  @@index([providerSubscriptionId])
}

// Avisos (webhooks) recebidos do provedor de pagamento: idempotência e diagnóstico. Sem dados de cartão.
model PaymentEvent {
  id                     String   @id @default(cuid())
  provider               String   @default("pagarme")
  providerEventId        String   @unique
  type                   String
  providerSubscriptionId String?
  organizationId         String?
  outcome                String? // synced | ignored | error
  error                  String?
  receivedAt             DateTime @default(now())
}

// Webhook de saída da organização (P4): avisa um sistema do cliente quando alertas abrem/resolvem.
// O segredo assina o corpo (HMAC-SHA256); só é mostrado na criação/troca, nunca devolvido pela API depois.
model WebhookEndpoint {
  id             String    @id @default(cuid())
  organizationId String    @unique
  url            String
  enabled        Boolean   @default(false)
  secret         String
  events         String    @default("[\"alert.created\",\"alert.resolved\"]")
  lastStatus     String? // ok | error
  lastStatusCode Int?
  lastError      String?
  lastEvent      String?
  lastAttemptAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// Fila de saída dos webhooks: o agendador entrega com até 3 tentativas. O corpo só fica guardado enquanto
// a entrega está pendente (é apagado ao entregar ou desistir); o id é o X-AtendeRadar-Delivery.
model WebhookDelivery {
  id             String    @id
  organizationId String
  event          String
  payload        String?
  status         String    @default("pending") // pending | sending | sent | failed | skipped
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now())
  lastStatusCode Int?
  lastError      String?
  createdAt      DateTime  @default(now())
  deliveredAt    DateTime?

  @@index([status, nextAttemptAt])
  @@index([organizationId, createdAt])
}

// Registro de auditoria (B4/B9): quem fez o quê. Só metadados — nunca texto de mensagem, telefone ou nome de cliente final.
model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorMemberId  String?
  actorEmail     String
  actorRole      String
  action         String
  targetType     String?
  targetId       String?
  targetLabel    String?
  details        String? // JSON pequeno (chaves alteradas, de/para)
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, action])
}

// Eventos de produto (I7): uso por tela, tour. First-party, sem dado pessoal: só ids internos e props pequenas
// (nada de texto de mensagem, telefone, e-mail ou nome). Apagados depois de PRODUCT_EVENTS_RETENTION_DAYS (padrão 400).
model ProductEvent {
  id             String   @id @default(cuid())
  organizationId String?
  memberId       String?
  name           String // screen_view | tour_completed | tour_skipped
  props          String? // JSON pequeno (até 500 caracteres)
  createdAt      DateTime @default(now())

  @@index([name, createdAt])
  @@index([organizationId, createdAt])
  @@index([createdAt])
}

// Marcos do funil (I7), um por organização: cadastro, 1ª conexão, 1ª conversa, 1º alerta, 1º pagamento.
// A chave composta garante que cada marco é gravado uma vez só. Ficam enquanto a organização existir.
model ProductMilestone {
  organizationId String
  name           String // signup | first_connection | first_conversation | first_alert | first_payment
  reachedAt      DateTime @default(now())

  @@id([organizationId, name])
  @@index([name, reachedAt])
}

// Visitas à página de vendas (I7): só um contador por dia e página. Sem cookie, sem IP, sem identificador.
model PageViewDaily {
  day   String // AAAA-MM-DD no horário de Brasília
  page  String // landing
  count Int    @default(0)

  @@id([day, page])
}

// Uso de provedor de IA (I7): tokens e custo estimado por chamada. Hoje a análise é por regras (nenhuma linha);
// quando um provedor entrar, cada chamada registra aqui por recordAiUsage() (src/lib/product-events.ts).
model AiUsage {
  id             String   @id @default(cuid())
  organizationId String
  conversationId String?
  provider       String
  model          String
  feature        String // classify | ...
  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  costBrl        Float    @default(0) // estimativa pelo preço configurado (AI_PRICE_BRL_PER_MTOK_IN/OUT)
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([createdAt])
}

/// Chamado aberto pelo "Falar com o suporte" da central de ajuda. Visto pelo operador da plataforma no Admin.
/// A captura de tela (opcional, png/jpg/webp, até 2 MB) fica no próprio banco: entra no backup e sai junto com a empresa.
model SupportTicket {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberId       String?
  authorName     String
  authorEmail    String
  subject        String
  message        String
  appVersion     String?
  screen         String? // tela do painel em que o cliente estava
  userAgent      String?
  screenshot     Bytes?
  screenshotType String? // image/png | image/jpeg | image/webp
  screenshotSize Int?
  status         String       @default("open") // open | resolved
  resolvedAt     DateTime?
  resolvedBy     String? // e-mail do operador
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([organizationId, createdAt])
}

/// Ambiente de simulação (S1): cada ação do operador (rodar cenário, injetar mensagem, rodar o motor, limpar) vira uma
/// linha. É também o registro de auditoria da simulação: a empresa simulada (e o AuditLog dela) some no "limpar".
model SimulationRun {
  id             String    @id @default(cuid())
  kind           String    @default("run") // run | inject | tick | clean
  scenarioId     String?
  status         String    @default("running") // running | passed | failed | error | done
  organizationId String? // empresa simulada (sem chave estrangeira: a linha fica depois que a empresa é apagada)
  virtualStart   DateTime? // instante "zero" do relógio simulado
  startedBy      String // e-mail do operador ou "token" (Bearer SIMULATION_SECRET) ou "cli"
  resultJson     String? // resultado por asserção (sem texto de cliente real: tudo é sintético)
  createdAt      DateTime  @default(now())
  finishedAt     DateTime?

  @@index([createdAt])
  @@index([scenarioId, createdAt])
}
