# Modelo de variáveis de ambiente do AtendeRadar. Copie para .env e preencha.
# Valores aqui são vazios ou de exemplo: NUNCA coloque segredo real neste arquivo (o repositório é público).
# Em produção as variáveis ficam no servidor (/opt/atende-radar/shared/app.env e dominios.env), não no git.

# --- Banco e login ---
# Banco SQLite (caminho relativo a prisma/).
DATABASE_URL="file:./dev.db"
# Segredo que assina as sessões (NextAuth). Gere um valor longo e aleatório.
NEXTAUTH_SECRET=""
# Endereço público do app; usado pelo NextAuth e nos links dos e-mails (padrão http://localhost:3000).
NEXTAUTH_URL="http://localhost:3000"
# E-mails (separados por vírgula) dos operadores da plataforma (tela Admin).
PLATFORM_ADMIN_EMAILS=""
# "true" exige e-mail confirmado para entrar (padrão: não exige).
REQUIRE_EMAIL_VERIFICATION=""
# Id da empresa de exemplo dos testes (padrão org_seed_1; não tem login público); fica fora do motor, das cotas e dos e-mails.
DEMO_ORG_ID=""
# Falhas de login por IP antes do bloqueio temporário (padrão 30).
LOGIN_FAILS_PER_IP=""
# Cadastros por IP por hora (padrão 20).
SIGNUP_RATE_LIMIT_PER_HOUR=""
# Só para testar o fim do teste grátis: contas criadas com esta variável ganham N minutos de teste em vez de 14 dias.
TRIAL_MINUTES=""
# Convites aceitos por IP por hora (padrão 30).
INVITE_RATE_LIMIT_PER_HOUR=""

# --- Domínios (entram no build; sem eles tudo roda num domínio só) ---
# Endereço do site (página de vendas, blog, páginas legais).
NEXT_PUBLIC_SITE_URL=""
# Endereço do app (entrar, cadastro, painel).
NEXT_PUBLIC_APP_URL=""
# E-mail de contato exibido no site e nas páginas legais.
NEXT_PUBLIC_CONTACT_EMAIL=""

# --- WhatsApp e motor de análise ---
# "on" liga a conexão real com o WhatsApp (Baileys) no servidor.
WHATSAPP_GATEWAY=""
# Pasta das sessões do WhatsApp (padrão ../wa-sessions, fora da pasta de deploy).
WA_SESSIONS_DIR=""
# Chave que cifra as sessões do WhatsApp em disco (32 bytes em base64, ex.: openssl rand -base64 32).
# Sem ela as sessões ficam em texto puro; perder a chave = as empresas leem o QR de novo.
WA_SESSIONS_KEY=""
# Segredo das chamadas do serviço do WhatsApp para /api/gateway/*.
GATEWAY_SECRET=""
# Segredo do hash dos telefones dos clientes (se vazio, usa o NEXTAUTH_SECRET).
PHONE_HASH_SECRET=""
# "off" desliga o ciclo automático de análise (os testes disparam o motor manualmente).
ANALYSIS_SCHEDULER=""

# --- E-mail ---
# "brevo" envia de verdade (e-mails transacionais); qualquer outro valor deixa os e-mails na fila (EmailOutbox).
MAIL_PROVIDER=""
# Chave da API do Brevo (a conta só aceita chamadas de IPs autorizados: teste de envio só a partir do servidor).
BREVO_API_KEY=""
# Remetente dos e-mails, ex.: "AtendeRadar <nao-responda@exemplo.com>" (domínio autenticado no Brevo).
MAIL_FROM=""
# Mautic: todo contato (membros, chamados de suporte, pedidos de plano) vai para lá; e-mail de marketing sai pelo Mautic.
# Vazio: não sincroniza.
MAUTIC_URL=""
MAUTIC_USUARIO=""
MAUTIC_SENHA=""
# Para onde vão os pedidos de troca de plano.
SALES_EMAIL=""
# Para onde vai o aviso de cada chamado novo de "Falar com o suporte". Vazio: o chamado só aparece em Admin › Suporte.
SUPPORT_EMAIL=""
# Reenvios de relatório por e-mail por empresa por hora (padrão 20).
REPORT_RESEND_PER_HOUR=""
# Exportações de todos os dados da empresa (LGPD) por empresa por hora (padrão 6).
ORG_EXPORT_PER_HOUR=""

# --- Métricas de uso (Admin › Produto) ---
# Dias que os eventos de uso brutos ficam guardados (padrão 400).
PRODUCT_EVENTS_RETENTION_DAYS=""
# Visitas contadas por IP por minuto na página de vendas (padrão 60).
PAGEVIEW_RATE_LIMIT_PER_MIN=""
# Escolhas no aviso de cookies contadas por IP por minuto (padrão 10).
CONSENT_RATE_LIMIT_PER_MIN=""

# --- Cobrança (Pagar.me) ---
# "live" usa as chaves de produção; qualquer outro valor (padrão: test) usa o sandbox.
PAGARME_MODE="test"
# Chave pública de produção (gera o token do cartão no navegador).
PAGARME_PUBLIC_KEY=""
# Chave secreta de produção (só no servidor).
PAGARME_SECRET_KEY=""
# Chave pública do sandbox.
PAGARME_PUBLIC_KEY_TEST=""
# Chave secreta do sandbox.
PAGARME_SECRET_KEY_TEST=""
# Usuário da autenticação básica do webhook /api/billing/webhook.
PAGARME_WEBHOOK_USER=""
# Senha da autenticação básica do webhook.
PAGARME_WEBHOOK_PASS=""
# Tentativas de pagamento por empresa por hora (padrão 8).
CHECKOUT_ATTEMPTS_PER_HOUR=""

# --- Medição: GTM, GA4 e Meta (docs/operacao/medicao.md) ---
# IDs públicos (o deploy grava no servidor). Sem GTM_ID válido (GTM-XXXX), o GTM não carrega.
GTM_ID=""
GA4_MEASUREMENT_ID=""
META_PIXEL_ID=""
# Segredos (secrets do GitHub, gravados pelo deploy). Sem eles, o envio pelo servidor só registra ga4:sem-id / meta:sem-id.
GA4_API_SECRET=""
META_CAPI_TOKEN=""
# Só durante o teste de ponta a ponta: "1" manda o purchase do servidor para o DebugView do GA4; código do "Testar
# eventos" da Meta. Apagar os dois depois do teste.
GA4_DEBUG=""
META_TEST_EVENT_CODE=""
# Código da meta tag "facebook-domain-verification" (verificação do domínio na Meta). Vazio: sem a tag.
META_DOMAIN_VERIFICATION=""
# "on" manda o sign_up ao GA4 também pelo servidor. Só depois de tirar o sign_up da tag GA4 do GTM (senão conta 2 vezes).
GA4_SERVER_SIGNUP=""
# Versão da API da Meta (padrão v23.0).
META_GRAPH_VERSION=""

# NFS-e Padrão Nacional (docs/operacao/nfse.md): nota de cada fatura paga, cancelada no reembolso.
# off (padrão) | restrita (testes do governo, sem valor fiscal) | producao
NFSE_AMBIENTE="off"
# Só faturas pagas a partir desta data (ISO) geram nota: ligar a emissão não emite notas do passado.
NFSE_DESDE=""
# Prestador: CNPJ e código IBGE do município (Piraquara/PR = 4119509); inscrição municipal se houver.
NFSE_CNPJ=""
NFSE_MUNICIPIO=""
NFSE_IM=""
# Certificado A1 (.p12/.pfx) FORA do repositório e a senha dele (nunca no GitHub).
NFSE_CERT_FILE=""
NFSE_CERT_PASSWORD=""
# Série das DPS (1 a 49999) e tributação. Códigos a confirmar com a contabilidade.
NFSE_SERIE="1"
NFSE_CTRIB_NAC="010501"
NFSE_CTRIB_MUN=""
NFSE_CNBS=""
# Percentual aproximado dos tributos do Simples Nacional (alíquota efetiva).
NFSE_P_TOT_TRIB_SN="6.00"
# 1 = Sistema Nacional falso, sem rede (só testes automáticos; exige NFSE_AMBIENTE=restrita).
NFSE_FAKE=""

# --- Backup (scripts/backup-db.ts e scripts/restore-drill.ts) ---
# Pasta dos backups (padrão ../backups).
BACKUP_DIR=""
# Quantos backups manter (padrão 30).
BACKUP_KEEP=""
# "true" faz o backup falhar se o banco não existir (usado no servidor).
BACKUP_REQUIRE_DB=""

# --- Voz do tour (docs/operacao/tour-audio.md) ---
# Azure Speech, plano F0. Sem chave/região o tour usa a voz do navegador.
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION=""
# Voz neural (padrão pt-BR-FranciscaNeural).
AZURE_SPEECH_VOICE=""
# Pasta do cache de áudio (padrão .tour-audio/ na raiz do projeto).
TOUR_AUDIO_DIR=""

# --- Foto do perfil, logotipo e telefone cifrado (P7, B5/B9) ---
# Pasta das imagens enviadas (padrão .uploads/ na raiz do projeto; produção /opt/atende-radar/shared/uploads).
UPLOADS_DIR=""
# Chave do telefone completo dos contatos: 32 bytes em base64 (openssl rand -base64 32). Vazia = guarda só o final.
# Produção: gerada pelo deploy; guarde uma cópia fora do servidor (docs/operacao/telefone-cifrado.md).
PHONE_ENC_KEY=""

# --- Ambiente de simulação (S1, só o operador da plataforma) ---
# "on" liga as rotas /api/admin/simulation/* e a aba Simulação do Admin (desligado por padrão; docs/operacao/simulacao.md).
SIMULATION_ENABLED=""
# Segredo (16+ caracteres) para o agente/CLI chamar a API de simulação com Authorization: Bearer.
SIMULATION_SECRET=""
# "1" tira o log do Prisma em scripts de linha de comando (ex.: bun scripts/simular.ts).
DB_QUIET=""

# --- Classificação por IA (Claude; desligada por padrão; docs/operacao/ia.md) ---
# "claude" liga. Vazia = análise só pelas regras de palavras (nada sai do servidor).
AI_CLASSIFIER=""
# Chave da API da Anthropic. Sem ela a IA fica desligada.
ANTHROPIC_API_KEY=""
# Modelo (padrão claude-haiku-5-5).
AI_MODEL=""
# Máximo de chamadas por rodada do motor (padrão 20) e por empresa no dia (padrão 500).
AI_MAX_CALLS_PER_TICK=""
AI_DAILY_LIMIT_PER_ORG=""

# --- CRM comercial (docs/crm/09-deploy-e-rollback.md) ---
# O CRM é ligado empresa por empresa no Admin (desligado por padrão). "1" aqui desliga em todas, sem mexer no banco.
CRM_DISABLED=""

# --- Testes ---
# "1" inclui Firefox, Safari e iPhone no Playwright (bun run test:e2e:browsers já liga).
CROSS_BROWSER=""

# NODE_ENV e NEXT_RUNTIME também são lidos pelo código, mas quem define é o Next/Bun: não coloque aqui.
# Também fora daqui: NEXT_PUBLIC_APP_VERSION (o build preenche), AUTH_SECRET (nome antigo do NEXTAUTH_SECRET) e
# WEBHOOK_ALLOW_LOCAL (só nos testes, no playwright.config.ts). tests/unit/env-example.unit.spec.ts confere a lista.
